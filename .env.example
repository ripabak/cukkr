# =============================================
# Cukkr — Docker Compose Environment Variables
# =============================================
# Copy this file to .env at the monorepo root
# and fill in your values.
# All vars have sensible defaults.
# =============================================

# ===== Public domains (required in production) =====
# These are baked into the frontend/web bundles at build time,
# so they MUST point to the public URLs reachable from the browser.
PUBLIC_API_URL=https://api.cukkr.com
PUBLIC_AUTH_URL=https://api.cukkr.com/auth/api
PUBLIC_APP_URL=https://app.cukkr.com
PUBLIC_WEB_URL=https://cukkr.com

# ===== Runtime environment =====
NODE_ENV=production

# Database
DB_PASSWORD=cukkr
DB_PORT=5432

# Backend API
BACKEND_PORT=3000

# Better Auth
BETTER_AUTH_SECRET=your-better-auth-secret-here

# Web (Next.js landing)
WEB_PORT=3001

# Frontend (Expo web)
FRONTEND_PORT=8080

# Expo
EXPO_PUBLIC_ENV_CODE=production

# Strapi CMS
STRAPI_PORT=1337
STRAPI_APP_KEYS=toBeModified1,toBeModified2
STRAPI_API_TOKEN_SALT=tobemodified
STRAPI_ADMIN_JWT_SECRET=tobemodified
STRAPI_TRANSFER_TOKEN_SALT=tobemodified
STRAPI_JWT_SECRET=tobemodified
STRAPI_ENCRYPTION_KEY=tobemodified
STRAPI_API_TOKEN=

# Next.js
NEXT_SERVER_ACTIONS_ENCRYPTION_KEY=your-32-byte-encryption-key-here

# SMTP (optional — kosong aman untuk dev)
SMTP_HOST=smtp.gmail.com
SMTP_PORT=465
SMTP_USER=
SMTP_PASS=
SMTP_SECURE=true

# Walk-In PIN — minimal 32 karakter
WALK_IN_TOKEN_SECRET=walk-in-token-secret-minimum-32-chars-dev

# Web Push (VAPID)
VAPID_PUBLIC_KEY=your-vapid-public-key-placeholder
VAPID_PRIVATE_KEY=your-vapid-private-key-placeholder
VAPID_EMAIL=mailto:support@cukkr.com

# S3-compatible Storage (Minio / external)
STORAGE_ENDPOINT=http://localhost:9000
STORAGE_BUCKET=cukkr
STORAGE_ACCESS_KEY=your-storage-access-key
STORAGE_SECRET_KEY=your-storage-secret-key
